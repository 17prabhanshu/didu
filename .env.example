# Database
# Use PostgreSQL with connection pooling for production (Supabase, Neon, Railway, etc.)
# Example: postgresql://user:pass@host:5432/db?pgbouncer=true&connection_limit=1
DATABASE_URL="file:./dev.db"

# Authentication
# REQUIRED: Generate a strong random string (32+ chars) for production
# Run: openssl rand -base64 32
AUTH_SECRET="generate-a-secure-random-string-here"
ADMIN_EMAIL="admin@yourdomain.com"
ADMIN_PASSWORD="secure-random-password-here"

# Site
NEXT_PUBLIC_SITE_URL="https://yourdomain.com"

# Storage - Vercel Blob (REQUIRED for production file uploads)
# Get from Vercel Dashboard > Storage > Blob
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_token_here"

# Rate Limiting - Upstash Redis (REQUIRED for production rate limiting)
# Get from Upstash Console > Redis > REST API
UPSTASH_REDIS_REST_URL="https://your-redis.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_redis_rest_token_here"

# Optional: Analytics & Monitoring
# SENTRY_DSN=""
# POSTHOG_KEY=""
# ANALYTICS_CONFIG=""DIRECT_URL=""
